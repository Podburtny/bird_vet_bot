# Telegram
TELEGRAM_BOT_TOKEN=

# Access — Telegram user_id через запятую
ALLOWED_USER_IDS=5151392259,198424031
ADMIN_ID=198424031

# OpenRouter
OPENROUTER_API_KEY=

# Модели OpenRouter (значения по умолчанию можно не менять)
ANSWER_MODEL=anthropic/claude-sonnet-4.5
SUMMARY_MODEL=google/gemini-2.0-flash
TRANSCRIBE_MODEL=google/gemini-2.5-flash

# Локальное хранилище
DATA_DIR=data
# DATABASE_URL оставь пустым — будет SQLite в DATA_DIR/birdvet.sqlite3

# Новый кейс после стольких часов тишины
CASE_TIMEOUT_HOURS=4

# Monitoring (опционально)
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
